{
  "name": "orangehrm-playwright-automation",
  "version": "1.0.0",
  "description": "Production-style Playwright E2E and API automation for OrangeHRM",
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:api": "playwright test tests/API",
    "test:dashboard": "playwright test tests/Dashboard",
    "test:directory": "playwright test tests/Directory",
    "test:performance": "playwright test tests/Performance",
    "test:claim": "playwright test tests/Claim",
    "test:buzz": "playwright test tests/Buzz",
    "test:ai-analysis": "node scripts/run-ai-analysis.js",
    "test:admin": "playwright test tests/Admin",
    "test:pim": "playwright test tests/PIM",
    "test:leave": "playwright test tests/Leave",
    "test:recruitment": "playwright test tests/Recruitment",
    "test:time": "playwright test tests/Time",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:positive": "playwright test --grep @positive",
    "test:negative": "playwright test --grep @negative",
    "test:validation": "playwright test --grep @validation",
    "test:search": "playwright test --grep @search",
    "test:filter": "playwright test --grep @filter",
    "test:pagination": "playwright test --grep @pagination",
    "test:navigation": "playwright test --grep @navigation",
    "test:upload": "playwright test --grep @upload",
    "test:download": "playwright test --grep @download",
    "test:create": "playwright test --grep @create",
    "test:edit": "playwright test --grep @edit",
    "test:delete": "playwright test --grep @delete",
    "test:bulk-delete": "playwright test --grep @bulk-delete",
    "test:cancel": "playwright test --grep @cancel",
    "test:security": "playwright test --grep @security",
    "test:account": "playwright test --grep @account",
    "test:selection": "playwright test --grep @selection",
    "test:details": "playwright test --grep @details",
    "test:autocomplete": "playwright test --grep @autocomplete",
    "test:admin:smoke": "playwright test tests/Admin --grep @smoke",
    "test:admin:regression": "playwright test tests/Admin --grep @regression",
    "test:pim:smoke": "playwright test tests/PIM --grep @smoke",
    "test:pim:regression": "playwright test tests/PIM --grep @regression",
    "test:pim:positive": "playwright test tests/PIM --grep @positive",
    "test:pim:negative": "playwright test tests/PIM --grep @negative",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --project=chromium",
    "test:ci:smoke": "playwright test --project=chromium --grep @smoke",
    "test:ci:regression": "playwright test --project=chromium --grep @regression",
    "test:list": "playwright test --list",
    "test:last-failed": "playwright test --last-failed",
    "report": "playwright show-report",
    "report:open": "playwright show-report playwright-report",
    "install:browsers": "playwright install",
    "install:chromium": "playwright install chromium",
    "codegen": "playwright codegen",
    "clean:reports": "node scripts/clean-reports.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report:allure": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "api",
    "orangehrm"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  }
}
